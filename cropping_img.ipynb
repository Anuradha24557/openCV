    "import cv2 \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(r\"C:\\Users\\Anuradha\\Downloads\\flower.jpg\")\n",
    "crop = img[100:300,200:300]\n",
    "plt.title(\"Cropped Image\")\n",
    "plt.imshow(cv2.cvtColor(crop,cv2.COLOR_BGR2RGB))\n",
    "\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
